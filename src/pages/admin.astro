---
import '../styles/site.css';
import '../styles/admin.css';
---
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Admin | DH Makeup Studio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap">
</head>
<body>
<main id="main" class="wrap band band--tight">
  <h1 class="h2">Pengaturan situs</h1>

  <div id="adm-memuat" class="outcome" data-state="empty">
    <p class="outcome__title">Memeriksa sesi</p>
  </div>

  <form id="adm-login" class="form adm-login" hidden novalidate>
    <div class="field">
      <label for="adm-email">Email</label>
      <input type="email" id="adm-email" name="email" autocomplete="username" aria-describedby="adm-login-err">
    </div>
    <div class="field">
      <label for="adm-sandi">Kata sandi</label>
      <input type="password" id="adm-sandi" name="sandi" autocomplete="current-password" aria-describedby="adm-login-err">
    </div>
    <p class="field__error" id="adm-login-err" role="alert"></p>
    <div class="btn-row">
      <button class="btn btn--primary" type="submit" id="adm-masuk">Masuk</button>
    </div>
  </form>

  <section id="adm-panel" class="adm-panel" hidden>
    <p class="fine">Masuk sebagai <span id="adm-siapa"></span>.
      <button class="btn btn--quiet" type="button" id="adm-keluar">Keluar</button></p>

    <!-- Nama tab di sini dipasangkan dengan wadah foto di admin-foto.js lewat
         id wadahnya: panel-beranda memuat #adm-foto-beranda, dan seterusnya.
         Menambah kelompok foto berarti menambah tab di sini juga. -->
    <div class="adm-tablist" role="tablist" aria-label="Bagian admin">
      <button class="adm-tab" type="button" role="tab" id="tab-pengaturan"
        aria-controls="panel-pengaturan" aria-selected="true" tabindex="0">Pengaturan</button>
      <button class="adm-tab" type="button" role="tab" id="tab-beranda"
        aria-controls="panel-beranda" aria-selected="false" tabindex="-1">Beranda</button>
      <button class="adm-tab" type="button" role="tab" id="tab-acara"
        aria-controls="panel-acara" aria-selected="false" tabindex="-1">Kategori acara</button>
      <button class="adm-tab" type="button" role="tab" id="tab-portofolio"
        aria-controls="panel-portofolio" aria-selected="false" tabindex="-1">Portofolio</button>
      <button class="adm-tab" type="button" role="tab" id="tab-tentang"
        aria-controls="panel-tentang" aria-selected="false" tabindex="-1">Tentang</button>
    </div>

    <div class="adm-tabpanel" role="tabpanel" id="panel-pengaturan" aria-labelledby="tab-pengaturan">
      <div id="adm-isi"></div>
    </div>
    <div class="adm-tabpanel" role="tabpanel" id="panel-beranda" aria-labelledby="tab-beranda" hidden>
      <div id="adm-foto-beranda"></div>
    </div>
    <div class="adm-tabpanel" role="tabpanel" id="panel-acara" aria-labelledby="tab-acara" hidden>
      <div id="adm-foto-acara"></div>
    </div>
    <div class="adm-tabpanel" role="tabpanel" id="panel-portofolio" aria-labelledby="tab-portofolio" hidden>
      <div id="adm-foto-portofolio"></div>
    </div>
    <div class="adm-tabpanel" role="tabpanel" id="panel-tentang" aria-labelledby="tab-tentang" hidden>
      <div id="adm-foto-tentang"></div>
    </div>
  </section>
</main>
<script>import '../scripts/admin.js';</script>
</body>
</html>
