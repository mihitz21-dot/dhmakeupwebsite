---
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import { getSite, rupiah } from '../data/site';
import { getFoto } from '../data/foto';
import { alamatKanonik } from '../lib/alamat';
const site = await getSite();

// ---------------------------------------------------------------- JSON-LD
// Schema LocalBusiness hanya di beranda, bukan di tiap halaman. Satu entitas
// bisnis cukup diumumkan satu kali, di halaman yang mewakili bisnisnya.
//
// Tipe yang dipakai: HealthAndBeautyBusiness, bukan BeautySalon. BeautySalon
// menyatakan adanya salon yang bisa didatangi pelanggan, sedangkan perias ini
// mendatangi lokasi klien dan tidak punya gerai. Keduanya sama-sama turunan
// LocalBusiness, jadi mesin pencari memperlakukannya setara, tapi
// HealthAndBeautyBusiness tidak mengklaim tempat yang tidak ada. Konsekuensinya
// `address` memang tidak ada, dan cakupan wilayah dinyatakan lewat areaServed.
//
// Isinya diambil dari getSite() supaya ikut berubah begitu pemilik situs
// menyunting pengaturannya, tanpa menyentuh berkas ini.
const foto = await getFoto();
const heroFoto = foto.get('hero');
const gambarLd = new URL(
  heroFoto?.berkas ? '/assets/foto/' + heroFoto.berkas : '/assets/og-bawaan.jpg',
  Astro.site,
).href;

// Nomor WhatsApp disimpan dalam format lokal ("08...") karena itu yang ditulis
// pemilik situs di halaman admin. Schema.org meminta nomor telepon yang bisa
// dihubungi lintas negara, jadi di sini saja nomornya diubah ke bentuk +62.
function keE164(nomor: string): string | null {
  const angka = nomor.replace(/\D/g, '');
  if (angka.length < 9) return null;
  if (angka.startsWith('62')) return '+' + angka;
  if (angka.startsWith('0')) return '+62' + angka.slice(1);
  return '+' + angka;
}

const telepon = site.kontak.whatsapp ? keE164(site.kontak.whatsapp) : null;
const instagram = site.kontak.instagram
  ? 'https://instagram.com/' + site.kontak.instagram.replace(/^@/, '')
  : null;

// Objek dibangun dulu di JavaScript, lalu baru di-JSON.stringify. Tidak ada
// perangkaian string JSON dengan tangan, supaya nilai apa pun dari basis data
// tidak bisa menghasilkan JSON rusak.
const ld: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'HealthAndBeautyBusiness',
  name: site.nama,
  url: alamatKanonik(Astro.site, '/'),
  image: gambarLd,
  description:
    'Perias pengantin dan makeup artist yang mendatangi lokasi klien. Soft glam, ' +
    'natural look, dan kids makeup untuk wedding, lamaran, pre-wedding, wisuda, ' +
    'dan photoshoot.',
  areaServed: site.area.map((a) => ({ '@type': 'City', name: a })),
};

// Properti bernilai null TIDAK dimasukkan. Lebih baik propertinya tidak ada
// daripada ada tapi kosong: "email": null atau "email": "" adalah data palsu
// yang ikut dibaca mesin pencari. Email, jam balas, DP, dan pembatalan memang
// masih kosong sekarang, jadi cabang ini benar-benar terpakai.
if (telepon) ld.telephone = telepon;
if (site.kontak.email) ld.email = site.kontak.email;
if (instagram) ld.sameAs = [instagram];
if (site.kontak.jamOperasional) ld.openingHours = site.kontak.jamOperasional;

// "<" diloloskan supaya nilai yang memuat "</script>" tidak bisa menutup blok
// skrip ini lebih awal dan menyuntikkan markup ke halaman.
const ldJson = JSON.stringify(ld, null, 2).replace(/</g, '\\u003c');
---
<Base
  judul="DH Makeup Studio | MUA Bandung, Subang, Cimahi, Jakarta"
  deskripsi="DH Makeup Studio merias soft glam, natural, dan kids makeup untuk wedding, lamaran, pre-wedding, wisuda, dan photoshoot di Bandung, Subang, Cimahi, dan Jakarta."
  halaman="/"
>

  <section class="hero">
    <span class="ghost-no ghost-no--tr" aria-hidden="true">01</span>
    <div class="wrap hero__grid">
      <div class="hero__copy reveal">
        <p class="hero__eyebrow">Perias Bandung &middot; Subang &middot; Cimahi &middot; Jakarta</p>
        <h1 class="display">Rias yang mempertegas wajah Anda, <em>bukan menggantinya.</em></h1>
        <p class="lede hero__sub">Soft glam, natural look, dan kids makeup untuk wedding, lamaran, pre-wedding, wisuda, dan photoshoot. Berbasis di Bandung, Subang, dan Cimahi, rutin ke Jakarta, bisa diajak ke luar kota.</p>
        <div class="btn-row hero__cta">
          <a class="btn btn--primary" href="/kontak#booking">Tanya tanggal Anda</a>
          <a class="btn btn--line" href="/portofolio">Lihat arsip rias</a>
        </div>
        <dl class="hero__facts">
          <div class="hero__fact">
            <dt>Area layanan</dt>
            <dd>Bandung, Subang, Cimahi, Jakarta</dd>
          </div>
          <div class="hero__fact">
            <dt>Pilihan bulu mata</dt>
            <dd>Dengan atau tanpa, Anda yang pilih</dd>
          </div>
        </dl>
      </div>

      <div class="hero__figure reveal" style="--i:2">
        <div class="arch">
          <PhotoSlot slot="hero" no="01" label="Foto utama" />
        </div>
        <p class="hero__caption">
          <span>Slot foto utama, rasio 4:5</span>
          <span>Plat 01</span>
        </p>
      </div>
    </div>
  </section>

  <section class="band band--paper band--edge" aria-labelledby="spes-h">
    <div class="wrap">
      <Plate no="02" label="Yang dikerjakan" class="reveal" />
      <h2 class="h2 reveal" id="spes-h" style="max-width:17ch;">Tiga hal yang kami kerjakan tiap minggu</h2>
      <p class="lede reveal" style="margin:1.25rem 0 3.5rem;">Bukan daftar panjang yang menjanjikan segalanya. Tiga ini yang paling sering dipesan, dan tiga ini yang paling kami kuasai.</p>

      <div class="spec">
        <article class="spec__item spec__item--a reveal">
          <span class="spec__no">01</span>
          <h3 class="spec__name">Soft Glam</h3>
          <p class="spec__desc">Dimensi di mata dan pipi, kulit tetap terlihat kulit. Dipakai untuk resepsi, lamaran, dan acara malam yang banyak foto.</p>
          <span class="spec__tag">Paling sering dipesan</span>
        </article>
        <article class="spec__item spec__item--b reveal" style="--i:1">
          <span class="spec__no">02</span>
          <h3 class="spec__name">Natural Look</h3>
          <p class="spec__desc">Riasan tipis untuk wisuda, akad pagi, dan sesi foto outdoor. Tujuannya Anda masih dikenali di foto, hanya versi yang lebih rapi.</p>
          <span class="spec__tag">Paling ringan di kulit</span>
        </article>
        <article class="spec__item spec__item--c reveal" style="--i:2">
          <span class="spec__no">03</span>
          <h3 class="spec__name">Kids Makeup</h3>
          <p class="spec__desc">Rias anak untuk pentas, foto keluarga, dan acara sekolah. Produk dipilih yang paling ringan dan prosesnya dibuat sesingkat mungkin.</p>
          <span class="spec__tag">Jarang ditawarkan MUA lain</span>
        </article>
      </div>
    </div>
  </section>

  <section class="band band--ink band--tall" aria-labelledby="acara-h">
    <span class="ghost-no ghost-no--bl" aria-hidden="true">03</span>
    <div class="wrap">
      <p class="pull reveal">&ldquo;My goal is simple, to make you look stunning and feel unforgettable.&rdquo;</p>
      <hr class="rule-double reveal" style="margin:3.5rem 0;">

      <Plate no="03" label="Jenis acara" class="reveal" />
      <h2 class="h2 reveal" id="acara-h">Acara yang biasa kami tangani</h2>

      <!-- Lima plat kecil di daftar ini memakai slot acara-01 sampai acara-05.
           Fotonya diunggah lewat halaman admin, bukan ditulis di berkas ini:
           PhotoSlot membaca kolom berkas, alt, lebar, dan tinggi dari tabel
           foto saat build, dan menggambar placeholder selama berkas masih
           kosong. -->
      <ul class="lineup reveal" style="margin-top:3rem;">
        <li><a href="/layanan#wedding">
          <span class="occ__thumb"><PhotoSlot slot="acara-01" no="01" label="Wedding" varian="gelap" /></span>
          <span class="occ__name">Wedding</span>
          <span class="occ__note">Akad dan resepsi, termasuk hairdo atau penataan hijab dan touch up di lokasi.</span>
        </a></li>
        <li><a href="/layanan#lamaran">
          <span class="occ__thumb"><PhotoSlot slot="acara-02" no="02" label="Lamaran" varian="gelap" /></span>
          <span class="occ__name">Lamaran</span>
          <span class="occ__note">Riasan yang kuat di foto dekat, karena acara lamaran rata-rata ruangan kecil.</span>
        </a></li>
        <li><a href="/layanan#prewedding">
          <span class="occ__thumb"><PhotoSlot slot="acara-03" no="03" label="Pre-wedding" varian="gelap" /></span>
          <span class="occ__name">Pre-wedding</span>
          <span class="occ__note">Satu kali ganti gaya rambut sudah termasuk, menyesuaikan dua konsep foto.</span>
        </a></li>
        <li><a href="/layanan#wisuda">
          <span class="occ__thumb"><PhotoSlot slot="acara-04" no="04" label="Wisuda" varian="gelap" /></span>
          <span class="occ__name">Wisuda dan acara</span>
          <span class="occ__note">Datang pagi buta kalau perlu, karena jadwal wisuda jarang bersahabat.</span>
        </a></li>
        <li><a href="/layanan#photoshoot">
          <span class="occ__thumb"><PhotoSlot slot="acara-05" no="05" label="Photoshoot" varian="gelap" /></span>
          <span class="occ__name">Photoshoot</span>
          <span class="occ__note">Disesuaikan dengan lampu studio atau cahaya matahari, dibicarakan dengan fotografernya.</span>
        </a></li>
      </ul>
    </div>
  </section>

  <section class="band band--pale" aria-labelledby="karya-h">
    <div class="wrap">
      <Plate no="04" label="Arsip" class="reveal" />
      <div class="closer reveal" style="margin-bottom:3rem;">
        <h2 class="h2" id="karya-h">Arsip hasil rias</h2>
        <a class="btn btn--quiet" href="/portofolio">Buka portofolio lengkap</a>
      </div>

      <div class="notice reveal" style="margin-bottom:3rem;max-width:48rem;">
        <strong>Catatan untuk pemilik situs</strong>
        <span>Slot foto di bawah masih kosong. Taruh berkasnya di folder <code>assets/foto/</code> dengan nama yang tertulis di tiap bingkai, lalu ganti isi bingkai itu dengan tag <code>&lt;img&gt;</code>. Rasio sudah dipesan, jadi tata letak tidak akan bergeser.</span>
      </div>

      <div class="gallery">
        <figure class="shot shot--w2 shot--tall reveal">
          <div class="shot__frame">
            <PhotoSlot slot="beranda-01" no="01" label="Rias pengantin" />
          </div>
          <figcaption><span class="shot__no">01</span><span class="shot__txt">Rias pengantin, rasio 4:6</span></figcaption>
        </figure>
        <figure class="shot shot--w4 shot--wide reveal" style="--i:1">
          <div class="shot__frame">
            <PhotoSlot slot="beranda-02" no="02" label="Lamaran" />
          </div>
          <figcaption><span class="shot__no">02</span><span class="shot__txt">Lamaran, rasio 16:12</span></figcaption>
        </figure>
        <figure class="shot shot--w4 shot--wide shot--drop reveal" style="--i:2">
          <div class="shot__frame">
            <PhotoSlot slot="beranda-03" no="03" label="Natural" />
          </div>
          <figcaption><span class="shot__no">03</span><span class="shot__txt">Natural, rasio 16:12</span></figcaption>
        </figure>
        <figure class="shot shot--w2 shot--tall reveal" style="--i:3">
          <div class="shot__frame">
            <PhotoSlot slot="beranda-04" no="04" label="Kids makeup" />
          </div>
          <figcaption><span class="shot__no">04</span><span class="shot__txt">Kids makeup, rasio 4:6</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="band band--rose band--tall" aria-labelledby="paket-h">
    <span class="ghost-no ghost-no--tr" aria-hidden="true">05</span>
    <div class="wrap">
      <Plate no="05" label="Paket" class="reveal" />
      <div class="closer reveal" style="margin-bottom:3rem;">
        <h2 class="h2" id="paket-h" style="max-width:18ch;">Tiga paket, dibedakan oleh jumlah touch up</h2>
        <a class="btn btn--quiet" href="/paket">Rincian dan tambahan</a>
      </div>

      <div class="tiers">
        {site.paket.map((p, i) => (
          <article class={i === 2 ? "tier tier--full reveal" : "tier reveal"} style={i > 0 ? `--i:${i}` : undefined}>
            <span class="tier__no">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="tier__name">{p.nama}</h3>
            <p class="tier__price">{rupiah(p.harga)}</p>
            <p class="tier__for">{p.ringkas.untuk}</p>
            <p class="tier__mark">{p.ringkas.penanda}</p>
            <ul>
              {p.ringkas.isi.map((x) => (
                <li><svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M1.5 6.5 4.5 9.5 10.5 2.5"/></svg><span>{x}</span></li>
              ))}
            </ul>
            <a class={i === 2 ? "btn btn--gold" : "btn btn--line"} href="/kontak#booking">Tanya tanggal untuk {p.nama}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--blush band--edge" aria-labelledby="tutup-h">
    <div class="wrap closer reveal">
      <div>
        <h2 class="display display--sm" id="tutup-h">Tanggal akhir pekan paling cepat penuh.</h2>
        <p class="lede" style="margin-top:1.5rem;">Kirim tanggal Anda dulu, nanti kami balas kosong atau tidaknya. Tidak ada kewajiban lanjut sesudah itu.</p>
      </div>
      <div class="btn-row">
        <a class="btn btn--primary" href="/kontak#booking">Cek ketersediaan tanggal</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" is:inline set:html={ldJson}></script>

</Base>
